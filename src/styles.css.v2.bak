@import url('https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap');
:root{font-family:"gg sans",Inter,system-ui,sans-serif;color:#20134a;background:#f7f5ff;--bg:#f7f5ff;--panel:#fff;--soft:#f1edff;--line:#ddd5fb;--text:#20134a;--muted:#6d6680;--accent:#7c3aed;--accent2:#5b21b6;--good:#15803d;--bad:#b91c1c;--shadow:0 18px 50px rgba(67,38,126,.10)}:root[data-theme=dark]{color:#f4efff;background:#070b14;--bg:#070b14;--panel:#111827;--soft:#182136;--line:#2c3853;--text:#f4efff;--muted:#a79fb8;--accent:#8b5cf6;--accent2:#7c3aed;--good:#34d399;--bad:#f87171;--shadow:0 18px 60px rgba(0,0,0,.28)}*{box-sizing:border-box}body{margin:0;overflow:hidden;background:var(--bg)}button,select,input{font:inherit}.app-shell{display:flex;height:100vh;background:var(--bg);color:var(--text);transition:background .25s,color .25s}.sidebar{width:72px;background:var(--panel);border-right:1px solid var(--line);display:flex;flex-direction:column;padding:14px 10px;transition:width .26s cubic-bezier(.22,1,.36,1);overflow:hidden}.sidebar.expanded{width:220px}.logo{width:46px;height:46px;object-fit:cover;border-radius:14px;margin:0 3px 12px}.sidebar nav{display:flex;flex-direction:column;gap:6px}.rail-button{height:44px;border:0;background:transparent;color:var(--muted);border-radius:12px;display:flex;align-items:center;gap:13px;padding:0 14px;white-space:nowrap;cursor:pointer;transition:.18s}.rail-button svg{min-width:20px;width:20px}.rail-button span{opacity:0;transition:opacity .16s}.expanded .rail-button span{opacity:1}.rail-button:hover,.rail-button.active{background:var(--soft);color:var(--accent)}.expand{margin-bottom:8px}.sidebar-bottom{margin-top:auto}.online-dot{width:8px;height:8px;border-radius:50%;background:#22c55e;margin:14px 20px}.workspace{flex:1;min-width:0;display:flex;flex-direction:column}header{height:82px;background:var(--panel);border-bottom:1px solid var(--line);display:flex;align-items:center;justify-content:space-between;padding:0 28px}header h1{font-size:20px;margin:3px 0 0}header small,.eyebrow{font-size:10px;letter-spacing:.16em;font-weight:800;color:var(--accent)}.header-actions{display:flex;gap:12px;align-items:center}.badge{background:var(--soft);color:var(--accent);padding:7px 11px;border-radius:999px;font-size:10px;font-weight:800}.primary{border:0;border-radius:12px;background:linear-gradient(135deg,var(--accent),var(--accent2));color:#fff;padding:11px 16px;font-weight:700;display:flex;align-items:center;gap:8px;cursor:pointer}.primary svg{width:17px}.danger{background:#dc2626}.page{padding:26px;overflow:auto;flex:1}.hero,.card{background:var(--panel);border:1px solid var(--line);border-radius:22px;box-shadow:var(--shadow)}.hero{padding:28px;display:flex;justify-content:space-between;align-items:center;margin-bottom:18px}.hero h2{font-size:32px;margin:8px 0}.hero p,.muted{color:var(--muted)}.today{display:flex;flex-direction:column;align-items:flex-end}.today b{font-size:38px;color:var(--accent)}.today span{color:var(--muted);font-size:12px}.grid.two{display:grid;grid-template-columns:1fr 1fr;gap:18px}.card{padding:20px}.card-title{display:flex;align-items:center;gap:11px;margin-bottom:18px}.card-title i{display:grid;place-items:center;width:34px;height:34px;border-radius:10px;background:var(--soft);color:var(--accent)}.card-title svg{width:18px}.card-title h3{margin:0;font-size:15px}.card label{display:block;font-size:11px;font-weight:700;color:var(--muted);margin:12px 0 6px}.select-like,select{width:100%;height:42px;border-radius:11px;border:1px solid var(--line);background:var(--soft);color:var(--text);padding:0 12px}.runtime{background:var(--soft);border-radius:14px;padding:8px 12px;margin-top:12px}.runtime div{display:flex;justify-content:space-between;padding:8px 0;font-size:12px}.runtime b{padding:4px 8px;border-radius:8px}.good{background:#dcfce7;color:#15803d}.bad{background:#fee2e2;color:#b91c1c}.warn{background:#fef3c7;color:#b45309}.switch-row{display:flex!important;justify-content:space-between;align-items:center}.switch{width:42px;height:24px;border:0;border-radius:20px;background:#a9a3b7;padding:3px;display:flex;justify-content:flex-start;cursor:pointer}.switch.on{background:var(--accent);justify-content:flex-end}.switch i{display:block;width:18px;height:18px;border-radius:50%;background:#fff}input[type=range]{width:100%;accent-color:var(--accent)}.metrics{display:flex;gap:10px;flex-wrap:wrap}.metrics span{background:var(--soft);padding:9px 12px;border-radius:10px;color:var(--muted);font-size:12px}.metrics b{color:var(--text);margin-left:5px}.console{height:calc(100vh - 220px);overflow:auto;background:#070b14;color:#d8e1f0;border-radius:14px;padding:16px;white-space:pre-wrap;font-family:"Cascadia Code",monospace;font-size:11px;line-height:1.55}.setup-backdrop{position:fixed;inset:0;background:rgba(27,15,52,.30);backdrop-filter:blur(10px);display:grid;place-items:center;z-index:20}.setup-panel{width:min(720px,calc(100vw - 48px));background:var(--panel);border:1px solid var(--line);border-radius:26px;padding:34px;box-shadow:0 30px 100px rgba(30,15,60,.30)}.setup-panel h2{font-size:32px;margin:10px 0}.setup-panel p{color:var(--muted)}.progress{height:8px;border-radius:10px;background:var(--soft);overflow:hidden;margin:24px 0}.progress i{display:block;height:100%;background:var(--accent);border-radius:10px}.setup-next{margin-left:auto;margin-top:25px}.setup-form{max-width:560px}@media(max-width:850px){.grid.two{grid-template-columns:1fr}.hero{align-items:flex-start}.today{display:none}}
