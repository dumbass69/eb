import React, { useEffect, useMemo, useRef, useState } from 'react';
import { AnimatePresence, motion } from 'framer-motion';
import { Activity, Bot, CalendarClock, ChevronDown, ChevronLeft, ChevronRight, CircleStop, Cpu, Home as HomeIcon, Info, MemoryStick, Moon, Play, RefreshCw, Settings, Sun, TerminalSquare, X } from 'lucide-react';
import { invoke } from '@tauri-apps/api/core';
import { listen } from '@tauri-apps/api/event';

type Page='home'|'activity'|'memory'|'locks'|'hardware'|'settings';
type Config={thinking:boolean;adaptive:boolean;errorRate:number;vramProfile:string;theme:'light'|'dark'};
type Status={running:boolean;engineOnline:boolean;modelReady:boolean;model:string;today:number;questions:number;correct:number;incorrect:number;context:number;contextMax:number;adaptive:boolean};
type ModelInfo={name:string;installed:boolean;preferred:boolean};
const emptyStatus:Status={running:false,engineOnline:false,modelReady:false,model:'gemma4:e4b',today:0,questions:0,correct:0,incorrect:0,context:0,contextMax:8192,adaptive:true};
const defaultConfig:Config={thinking:false,adaptive:true,errorRate:15,vramProfile:'Balanced · recommended',theme:'light'};
const PRESETS=['gemma4:e4b','gemma4:12b','gemma4:26b','gemma3:12b','gemma3:27b','qwen3-vl:8b','qwen2.5vl:7b'];

class ScreenBoundary extends React.Component<{children:React.ReactNode},{error:string}>{
 constructor(p:{children:React.ReactNode}){super(p);this.state={error:''}}
 static getDerivedStateFromError(e:any){return{error:String(e?.message||e)}}
 componentDidCatch(e:any,info:any){console.error('Screen render failure',e,info)}
 render(){if(this.state.error)return <div className="screen-error"><h2>This panel could not be displayed</h2><pre>{this.state.error}</pre><button className="primary" onClick={()=>this.setState({error:''})}>Return</button></div>;return this.props.children}}

export function App(){
 const [page,setPage]=useState<Page>('home'); const [setup,setSetup]=useState<{open:boolean;step:number;busy:boolean;message:string}>({open:false,step:1,busy:false,message:''}); const [side,setSide]=useState(false); const [status,setStatus]=useState(emptyStatus); const [config,setConfig]=useState(defaultConfig); const [logs,setLogs]=useState<string[]>([]); const [models,setModels]=useState<ModelInfo[]>(PRESETS.map(name=>({name,installed:false,preferred:name==='gemma4:e4b'}))); const [consoleOpen,setConsoleOpen]=useState(false); const [fatal,setFatal]=useState('');
 const refreshModels=()=>invoke<ModelInfo[]>('list_models').then(x=>setModels(x.length?x:PRESETS.map(name=>({name,installed:false,preferred:name==='gemma4:e4b'})))).catch(e=>setLogs(v=>[...v,`[Models] ${e}`]));
 useEffect(()=>{let alive=true; Promise.all([invoke<Status>('backend_status'),invoke<any>('load_preferences')]).then(([st,p])=>{if(!alive)return;setStatus({...emptyStatus,...st});setConfig({...defaultConfig,...p});setSetup(x=>({...x,open:!p.firstLaunchComplete}))}).catch(e=>setFatal(String(e))); refreshModels(); const a=listen<string>('backend-log',e=>setLogs(v=>[...v.slice(-999),e.payload]));const b=listen<Status>('backend-status',e=>setStatus({...emptyStatus,...e.payload}));return()=>{alive=false;a.then(f=>f());b.then(f=>f())}},[]);
 useEffect(()=>{document.documentElement.dataset.theme=config.theme},[config.theme]);
 const save=(next:Config)=>{setConfig(next);invoke('save_preferences',{preferences:next}).catch(e=>setLogs(v=>[...v,`[Settings] ${e}`]))};
 const setModel=async(name:string)=>{setStatus(s=>({...s,model:name,modelReady:models.some(m=>m.name===name&&m.installed)}));await invoke('set_model',{model:name});await refreshModels()};
 const toggle=()=>invoke(status.running?'stop_agent':'start_agent',{config}).catch(e=>setLogs(v=>[...v,`[Agent] ${e}`]));
 const nav=useMemo(()=>[{id:'home',label:'Home',icon:HomeIcon},{id:'activity',label:'Live Activity',icon:Activity},{id:'memory',label:'Memory Manager',icon:MemoryStick},{id:'locks',label:'Lock Calendar',icon:CalendarClock},{id:'hardware',label:'Hardware',icon:Cpu},{id:'settings',label:'Settings',icon:Settings}] as const,[]);
 if(fatal)return <div className="fatal"><h2>Backend did not start</h2><pre>{fatal}</pre></div>;
 return <div className="app-shell"><aside className={side?'sidebar expanded':'sidebar'}><img className="logo" src="/logo.png"/><button className="rail-button" onClick={()=>setSide(!side)}>{side?<ChevronLeft/>:<ChevronRight/>}<span>{side?'Collapse':'Expand'}</span></button><nav>{nav.map(n=><button key={n.id} title={n.label} className={'rail-button '+(page===n.id?'active':'')} onClick={()=>setPage(n.id)}><n.icon/><span>{n.label}</span></button>)}</nav><div className="sidebar-bottom"><button className="rail-button" title="Light / dark mode" onClick={()=>save({...config,theme:config.theme==='light'?'dark':'light'})}>{config.theme==='light'?<Sun/>:<Moon/>}<span>{config.theme==='light'?'Light':'Dark'}</span></button></div></aside>
 <main className="workspace"><header><div><small>LOCAL AI CONTROL</small><h1>Wiseman Autopilot</h1></div><div className="header-actions"><button className="icon-action" title="Open live console" onClick={()=>setConsoleOpen(true)}><TerminalSquare/></button><span className="badge">{status.engineOnline?'OLLAMA ONLINE':'OLLAMA OFFLINE'}</span><button className={status.running?'primary danger':'primary'} onClick={toggle}>{status.running?<><CircleStop/>Stop</>:<><Play/>Launch Session</>}</button></div></header>
 <ScreenBoundary><AnimatePresence mode="wait"><motion.section key={page} className="page" initial={{opacity:0,x:24}} animate={{opacity:1,x:0}} exit={{opacity:0,x:-20}} transition={{duration:.2}}>{page==='home'&&<Home status={status} config={config} save={save} models={models} setModel={setModel}/>} {page==='activity'&&<ActivityPage logs={logs} status={status}/>} {page==='memory'&&<MemoryPage/>} {page==='locks'&&<LocksPage/>} {page==='hardware'&&<HardwarePage/>} {page==='settings'&&<SettingsPage config={config} save={save}/>}</motion.section></AnimatePresence></ScreenBoundary></main>
 <ScreenBoundary><AnimatePresence>{consoleOpen&&<ConsolePopup logs={logs} close={()=>setConsoleOpen(false)} clear={()=>setLogs([])}/>}</AnimatePresence></ScreenBoundary>
 <AnimatePresence>{setup.open&&<FirstLaunch config={config} setConfig={setConfig} state={setup} setState={setSetup} finish={async(c,u,p)=>{await invoke('complete_setup',{preferences:c,username:u,password:p});setConfig(c);setSetup(x=>({...x,open:false}))}}/>}</AnimatePresence></div>
}
function Home({status,config,save,models,setModel}:{status:Status;config:Config;save:(x:Config)=>void;models:ModelInfo[];setModel:(x:string)=>void}){return <><section className="hero"><div><span className="eyebrow">LOCAL AI SESSION</span><h2>Ready when you are.</h2><p>The Python automation engine runs as a hidden sidecar controlled by this interface.</p></div><div className="today"><b>{status.today}</b><span>completed today</span></div></section><div className="grid two"><Card icon={<Bot/>} title="AI Runtime"><label>Active model</label><ModelSelect value={status.model} models={models} onChange={setModel}/><div className="runtime"><div><span>Engine</span><b className={status.engineOnline?'good':'bad'}>{status.engineOnline?'Online':'Offline'}</b></div><div><span>Model</span><b className={status.modelReady?'good':'warn'}>{status.modelReady?'Ready':'Pull on launch'}</b></div></div></Card><Card icon={<MemoryStick/>} title="Session Profile"><label>GPU memory mode</label><select value={config.vramProfile} onChange={e=>save({...config,vramProfile:e.target.value})}><option>Eco · lowest VRAM</option><option>Balanced · recommended</option><option>Performance · 16K</option><option>Overkill · 32K</option><option>Overkill · 64K</option></select><Switch label="AI Thinking Mode" value={config.thinking} onChange={v=>save({...config,thinking:v})}/><Switch label="Adaptive Context" value={config.adaptive} onChange={v=>save({...config,adaptive:v})}/><label>Intentional error rate <b>{config.errorRate}%</b></label><input type="range" min="0" max="100" value={config.errorRate} onChange={e=>save({...config,errorRate:+e.target.value})}/></Card></div></>}
function ModelSelect({value,models,onChange}:{value:string;models:ModelInfo[];onChange:(v:string)=>void}){const [open,setOpen]=useState(false);const ref=useRef<HTMLDivElement>(null);useEffect(()=>{const close=(e:MouseEvent)=>{if(!ref.current?.contains(e.target as Node))setOpen(false)};document.addEventListener('mousedown',close);return()=>document.removeEventListener('mousedown',close)},[]);const current=models.find(m=>m.name===value);return <div className="model-select" ref={ref}><button className="model-trigger" onClick={()=>setOpen(!open)}><span><b>{value}</b><small>{current?.installed?'Installed locally':'Available to pull automatically'}</small></span><ChevronDown className={open?'rotated':''}/></button><AnimatePresence>{open&&<motion.div className="model-menu" initial={{opacity:0,y:-6}} animate={{opacity:1,y:0}} exit={{opacity:0,y:-6}}>{models.map(m=><button key={m.name} className={m.name===value?'selected':''} onClick={()=>{onChange(m.name);setOpen(false)}}><span><b>{m.name}</b><small>{m.preferred?'Preferred · ':''}{m.installed?'Installed':'Pull on first use'}</small></span><i className={m.installed?'installed':''}/></button>)}</motion.div>}</AnimatePresence></div>}
function ActivityPage({logs,status}:{logs:string[];status:Status}){const end=useRef<HTMLDivElement>(null);useEffect(()=>end.current?.scrollIntoView({behavior:'smooth'}),[logs]);return <Card icon={<Activity/>} title="Live Activity" wide><div className="metrics"><span>Questions <b>{status.questions}</b></span><span>Correct <b>{status.correct}</b></span><span>Incorrect <b>{status.incorrect}</b></span><span title={status.adaptive?'Adaptive context chooses the smallest sufficient allocation up to the selected profile ceiling.':'Adaptive context is off; the selected profile allocation is requested directly.'}>Context <b>{Math.round(status.context/1024)}K / {Math.round(status.contextMax/1024)}K max</b></span></div><div className="console"><pre>{logs.length?logs.join('\n'):'Backend events will appear here.'}</pre><div ref={end}/></div></Card>}
function ConsolePopup({logs,close,clear}:{logs:string[];close:()=>void;clear:()=>void}){const end=useRef<HTMLDivElement>(null);useEffect(()=>end.current?.scrollIntoView({behavior:'smooth'}),[logs]);return <motion.div className="modal-backdrop" initial={{opacity:0}} animate={{opacity:1}} exit={{opacity:0}} onMouseDown={e=>e.target===e.currentTarget&&close()}><motion.div className="console-popup" initial={{scale:.97,y:18}} animate={{scale:1,y:0}}><div className="popup-head"><div><span className="eyebrow">PYTHON SIDECAR</span><h3>Live Console</h3></div><div><button className="ghost" onClick={clear}>Clear</button><button className="icon-action" onClick={close}><X/></button></div></div><div className="console popup-console"><pre>{logs.length?logs.join('\n'):'Waiting for backend output…'}</pre><div ref={end}/></div></motion.div></motion.div>}
function MemoryPage(){const [d,setD]=useState<any>();const load=()=>invoke<any>('memory_data').then(setD).catch(e=>setD({completed:[],quarantined:{},corrections:[],error:String(e)}));useEffect(()=>{void load()},[]);return <Card icon={<MemoryStick/>} title="Memory Manager" wide><Toolbar load={load}/>{!d?<p>Loading…</p>:<div className="memory-grid"><DataGroup title="Completed work" rows={d.completed||[]}/><DataGroup title="Temporary skips" rows={Object.entries(d.quarantined||{}).map(([k,v]:any)=>`${k} · retry ${v.retry_after||'unknown'}`)}/><DataGroup title="Learned corrections" rows={(d.corrections||[]).map((x:any)=>`${x.question||'Question'} · ${(x.correct_answer||[]).join(', ')}`)}/></div>}</Card>}
function LocksPage(){const [rows,setRows]=useState<any[]>([]);const load=()=>invoke<any[]>('lock_calendar').then(x=>setRows(Array.isArray(x)?x:[])).catch(()=>setRows([]));useEffect(()=>{void load()},[]);return <Card icon={<CalendarClock/>} title="Lock Calendar" wide><Toolbar load={load}/><div className="list-panel">{rows.length?rows.map((r,i)=><div className="list-row" key={i}><time>{r.releaseDate||'Unknown date'}</time><div><b>{r.name}</b><small>{r.evidence||'Release restriction detected by the agent'}</small></div></div>):<div className="empty-state">No future release locks are stored.</div>}</div></Card>}
function HardwarePage(){const [d,setD]=useState<any>();useEffect(()=>{void invoke<any>('hardware_info').then(setD).catch(e=>setD({gpu:'Unavailable',gpu_vendor:'Unknown',ram_gb:'?',recommended_ctx:8192,source:'Detection failed',warning:String(e)}))},[]);return <Card icon={<Cpu/>} title="Hardware & AI Memory" wide>{!d?<p>Detecting hardware…</p>:<div className="hardware-grid"><Metric label="Graphics" value={d.gpu}/><Metric label="GPU vendor" value={d.gpu_vendor}/><Metric label="Graphics memory" value={d.vram_total_gb?`${d.vram_total_gb} GB`:'Unavailable'}/><Metric label="System memory" value={`${d.ram_gb} GB`}/><Metric label="Recommended context" value={`${Math.round(d.recommended_ctx/1024)}K`}/><Metric label="Detection source" value={d.source}/>{d.warning&&<div className="hardware-warning">{d.warning}</div>}</div>}</Card>}
function SettingsPage({config,save}:{config:Config;save:(x:Config)=>void}){return <div className="grid two"><Card icon={<Settings/>} title="Appearance"><Switch label="Dark mode" value={config.theme==='dark'} onChange={v=>save({...config,theme:v?'dark':'light'})}/></Card><Card icon={<Cpu/>} title="Agent defaults"><Help text="Lets supported Ollama models perform a private reasoning pass before returning the structured answer. This is slower, but can improve inference and multi-step questions."><Switch label="AI Thinking Mode" value={config.thinking} onChange={v=>save({...config,thinking:v})}/></Help><Help text="Chooses the smallest useful context for each request, capped by the GPU memory profile. If disabled, a selected 32K profile requests 32K directly."><Switch label="Adaptive Context" value={config.adaptive} onChange={v=>save({...config,adaptive:v})}/></Help></Card></div>}
function FirstLaunch({config,setConfig,state,setState,finish}:{config:Config;setConfig:(c:Config)=>void;state:{open:boolean;step:number;busy:boolean;message:string};setState:any;finish:(c:Config,u:string,p:string)=>Promise<void>}){const [user,setUser]=useState('');const [pass,setPass]=useState('');const check=async()=>{setState((x:any)=>({...x,busy:true,step:2,message:'Checking for Ollama…'}));try{const r:any=await invoke('prepare_environment');setState((x:any)=>({...x,busy:false,step:3,message:r?.model?`Ready: ${r.model}`:'Ollama and a local model are ready.'}))}catch(e){setState((x:any)=>({...x,busy:false,message:String(e)}))}};return <motion.div className="setup-overlay" initial={{opacity:0}} animate={{opacity:1}} exit={{opacity:0}}><motion.div className="setup-card" initial={{scale:.97,y:18}} animate={{scale:1,y:0}}><span className="eyebrow">FIRST LAUNCH SETUP · {state.step}/3</span>{state.step===1&&<><h2>Welcome to Wiseman Autopilot</h2><p>Set up the local AI runtime once. The next launch opens directly to Home.</p><button className="primary setup-next" onClick={check}>Begin setup</button></>}{state.step===2&&<><h2>Preparing local AI</h2><p>{state.message}</p><div className="setup-loader"><i/></div>{!state.busy&&<button className="primary" onClick={check}>Retry</button>}</>}{state.step===3&&<><h2>Choose your defaults</h2><p className="setup-ready">✓ {state.message}</p><div className="setup-grid"><Help text="Allows supported models to make an additional reasoning pass. Slower, but useful for inference and multi-step questions."><Switch label="AI Thinking Mode" value={config.thinking} onChange={v=>setConfig({...config,thinking:v})}/></Help><Help text="Chooses the smallest useful context up to the selected memory profile ceiling."><Switch label="Adaptive Context" value={config.adaptive} onChange={v=>setConfig({...config,adaptive:v})}/></Help><label>Intentional error rate <b>{config.errorRate}%</b></label><input type="range" min="0" max="100" value={config.errorRate} onChange={e=>setConfig({...config,errorRate:+e.target.value})}/><label>Wiseman login name</label><input className="setup-input" value={user} onChange={e=>setUser(e.target.value)} placeholder="Optional username"/><label>Wiseman password</label><input className="setup-input" type="password" value={pass} onChange={e=>setPass(e.target.value)} placeholder="Protected with Windows DPAPI"/></div><button className="primary setup-next" onClick={()=>finish(config,user,pass)}>Finish setup</button></>}</motion.div></motion.div>}
function Help({text,children}:{text:string;children:any}){return <div className="help-row">{children}<span className="help-icon" tabIndex={0}><Info/><span className="tooltip">{text}</span></span></div>}
function Card({icon,title,children,wide=false}:{icon:any;title:string;children:any;wide?:boolean}){return <article className={'card '+(wide?'wide':'')}><div className="card-title"><i>{icon}</i><h3>{title}</h3></div>{children}</article>}
function Switch({label,value,onChange}:{label:string;value:boolean;onChange:(v:boolean)=>void}){return <label className="switch-row"><span>{label}</span><button type="button" className={'switch '+(value?'on':'')} onClick={()=>onChange(!value)}><motion.i layout/></button></label>}
function Toolbar({load}:{load:()=>void}){return <div className="toolbar"><button className="ghost" onClick={load}><RefreshCw/>Refresh</button></div>}
function DataGroup({title,rows}:{title:string;rows:string[]}){return <section className="data-group"><h4>{title}<span>{rows.length}</span></h4>{rows.length?rows.map((r,i)=><p key={i}>{typeof r==='string'?r:JSON.stringify(r)}</p>):<p className="muted">Nothing saved.</p>}</section>}
function Metric({label,value}:{label:string;value:any}){return <div className="metric-card"><span>{label}</span><b>{String(value??'Unknown')}</b></div>}
